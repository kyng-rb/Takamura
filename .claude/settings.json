{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(dotnet ef database:*)",
      "Bash(dotnet ef migrations remove:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Read(./src/Takamura.API/appsettings.Development.json)",
      "Read(./src/Takamura.Web/appsettings.Development.json)",
      "Read(./**/.env)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)"
    ]
  }
}
