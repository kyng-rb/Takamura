@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Error</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Outlined="true" Elevation="0" Class="pa-6">
        <MudText Typo="Typo.h4" Color="Color.Error" Class="mb-2">Oops, something went wrong.</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            An error occurred while processing your request. Please try again in a few seconds.
        </MudText>

        <img src="/images/error-funny.svg"
             alt="Funny error illustration"
             style="width:100%; max-width:640px; border-radius:12px; display:block; margin:0 auto 16px auto;" />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudText Typo="Typo.subtitle1" Class="mb-1"><strong>Error message</strong></MudText>
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <pre style="margin:0; white-space:pre-wrap; word-break:break-word;">@ErrorMessage</pre>
            </MudPaper>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorDetails))
        {
            <MudText Typo="Typo.subtitle1" Class="mb-1"><strong>Error details</strong></MudText>
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <pre style="margin:0; white-space:pre-wrap; word-break:break-word;">@ErrorDetails</pre>
            </MudPaper>
        }

        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </MudText>
        }
    </MudPaper>
</MudContainer>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    private string? Message { get; set; }

    [SupplyParameterFromQuery]
    private string? Details { get; set; }

    private string? RequestId { get; set; }
    private string? ErrorMessage { get; set; }
    private string? ErrorDetails { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        var serverException = HttpContext?.Features.Get<IExceptionHandlerPathFeature>()?.Error;

        ErrorMessage = !string.IsNullOrWhiteSpace(Message)
            ? Message
            : serverException?.Message;

        ErrorDetails = !string.IsNullOrWhiteSpace(Details)
            ? Details
            : serverException?.ToString();
    }

}
