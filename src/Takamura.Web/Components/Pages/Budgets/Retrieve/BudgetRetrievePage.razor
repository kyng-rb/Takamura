@page "/"

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">Budgets</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else if (!_budgets.Any())
    {
        <MudText>No available budgets.</MudText>
    }
    else
    {
        @foreach (var budget in _budgets)
        {
            <MudCard Outlined="true">
                <MudCardContent Class="d-flex align-center justify-space-between px-6 py-4">
                    <MudText Typo="Typo.h6" Class="mb-0">@budget.Title</MudText>

                    <MudCardActions Class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => Nav.NavigateTo($"/budgets/{budget.Id}/bills"))">
                            Bills
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Info"
                                   OnClick="@(() => Nav.NavigateTo($"/budgets/{budget.Id}/allocations"))">
                            Allocation
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="@(() => Nav.NavigateTo($"/budgets/{budget.Id}/balances"))">
                            Balance
                        </MudButton>
                    </MudCardActions>
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>
